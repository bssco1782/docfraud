# Document Fraud Detection API configuration. Copy to .env and edit; .env is git-ignored.
# All values are optional; defaults are shown in backend/config.py and DEPLOYMENT.md.

# Required for any shared deployment. The fallback "default-api-key" is insecure.
API_KEY=replace-with-a-long-random-secret

# Trained model file (falls back to data/models/fraud_model.pkl if this path does not exist)
MODEL_PATH=data/models/fraud_model.pkl

# Upload limit in bytes (10 MB)
MAX_FILE_SIZE=10485760

# Risk score at or above which /verify reports tampering
TAMPER_THRESHOLD=0.5

# Comma-separated allowed CORS origins; "*" allows any origin
CORS_ORIGINS=*

# Largest accepted image in pixels (PDF page 1 measured at 200 DPI); blocks decompression bombs
MAX_IMAGE_PIXELS=40000000

# Documents analysed at the same time per process (default: min(2, CPU count))
MAX_CONCURRENT_ANALYSES=2

# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
